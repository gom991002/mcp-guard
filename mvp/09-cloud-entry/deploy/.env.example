# Upstream secrets referenced from config/credentials.json as env:NAME.
# Copy to .env (git-ignored) on the server.
COMPANY_TOOLS_TOKEN=replace-me

# AWS hosting (D6-22). The region is used by Secrets Manager and CloudWatch Logs.
# AWS_REGION=ap-northeast-2
# Per-user upstream tokens in AWS Secrets Manager instead of /data/upstream-tokens.json.
# MCP_GUARD_TOKEN_STORE=aws-secrets-manager
# M1 audit events to CloudWatch Logs; /data/audit.jsonl stays as the local copy.
# Create the log group first, with retention and deletion protection.
# MCP_GUARD_AUDIT_LOG_GROUP=/mcp-guard/audit
# Horizon Labs B classifier: on by default (about 0.5 GB of memory, 16 ms per text,
# measured 2026-11-04). Set 0 to build the image without it and keep it off.
# MCP_GUARD_WITH_CLASSIFIER=0
# Review threshold (default 0.86, chosen so false holds stay at or under 2%).
# MCP_GUARD_B_THRESHOLD=0.86
# Pre-registered OAuth clients with secrets (Gemini Enterprise), made with
# python -m cloud_entry.admin add-client ...
# MCP_GUARD_OAUTH_CLIENTS=/config/oauth-clients.json
# On EC2, leave the keys unset to use the instance role. Keys written here give
# whoever reads this file access to every stored token.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
