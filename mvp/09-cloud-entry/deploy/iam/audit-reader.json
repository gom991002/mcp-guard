{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadAuditLog",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogStreams", "logs:GetLogEvents", "logs:FilterLogEvents",
        "logs:StartQuery", "logs:GetQueryResults", "logs:StopQuery"
      ],
      "Resource": "arn:aws:logs:<region>:<account>:log-group:/mcp-guard/audit:*"
    },
    {
      "Sid": "ListLogGroupsAndSeeTheAlertScreen",
      "Effect": "Allow",
      "Action": ["logs:DescribeLogGroups", "cloudwatch:GetDashboard", "cloudwatch:ListDashboards",
                 "cloudwatch:DescribeAlarms"],
      "Resource": "*"
    },
    {
      "Sid": "NeverChangeTheAuditLog",
      "Effect": "Deny",
      "Action": [
        "logs:DeleteLogGroup", "logs:DeleteLogStream", "logs:PutRetentionPolicy",
        "logs:DeleteRetentionPolicy", "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:<region>:<account>:log-group:/mcp-guard/audit*"
    }
  ]
}
