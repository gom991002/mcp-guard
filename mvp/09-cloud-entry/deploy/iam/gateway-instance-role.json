{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PerUserUpstreamTokens",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:PutSecretValue",
        "secretsmanager:CreateSecret"
      ],
      "Resource": "arn:aws:secretsmanager:<region>:<account>:secret:mcp-guard/upstream/*"
    },
    {
      "Sid": "WriteAuditEventsOnly",
      "Effect": "Allow",
      "Action": [
        "logs:PutLogEvents",
        "logs:CreateLogStream"
      ],
      "Resource": "arn:aws:logs:<region>:<account>:log-group:/mcp-guard/audit:*"
    },
    {
      "Sid": "SharedSessionState",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem"
      ],
      "Resource": "arn:aws:dynamodb:<region>:<account>:table/mcp-guard-state"
    }
  ]
}
